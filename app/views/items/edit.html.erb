<div class="edit-item-container">
  
  <!-- Back Button -->
  <div class="back-button">
    <%= link_to dashboard_index_path, class: "back-link" do %>
      <span>←</span> Back to Dashboard
    <% end %>
  </div>

  <!-- Edit Item Card -->
  <div class="edit-item-card" data-aos="fade-up">
    
    <!-- Header -->
    <div class="card-header">
      <div class="header-icon">✏️</div>
      <div class="header-text">
        <h1>Edit Item</h1>
        <p>Update your lost or found item information</p>
      </div>
      <div class="item-status-badge <%= @item.status %>">
        <%= @item.status.upcase %>
      </div>
    </div>

    <!-- Edit Form -->
    <%= form_with model: @item, local: true, html: { class: "edit-item-form", multipart: true } do |f| %>
      
      <div class="form-grid">
        <!-- Left Column -->
        <div class="form-column">
          <!-- Title -->
          <div class="form-group">
            <%= f.label :title, class: "form-label" do %>
              <span class="label-icon">🏷️</span>
              Item Title
            <% end %>
            <%= f.text_field :title, class: "form-input", 
                  placeholder: "e.g., Blue Backpack, iPhone 14", 
                  required: true %>
            <div class="form-hint">Be specific to help others identify the item</div>
          </div>

          <!-- Status -->
          <div class="form-group">
            <%= f.label :status, class: "form-label" do %>
              <span class="label-icon">📌</span>
              Status
            <% end %>
            <div class="status-select-wrapper">
              <%= f.select :status, 
                    Item.statuses.keys.map { |s| [s.titleize, s] }, 
                    {}, 
                    class: "form-select" %>
              <div class="status-hint">
                <span class="hint-icon">ℹ️</span>
                <span id="statusHint">Select if this item was lost or found</span>
              </div>
            </div>
          </div>

          <!-- Resolution Status -->
          <div class="form-group checkbox-group">
            <label class="checkbox-label">
              <%= f.check_box :is_resolved, class: "checkbox-input" %>
              <span class="checkbox-text">
                <strong>Mark as Resolved</strong>
                <small>Check this if the item has been returned to its owner</small>
              </span>
            </label>
          </div>
        </div>

        <!-- Right Column -->
        <div class="form-column">
          <!-- Current Image Preview -->
          <% if @item.image_path.present? %>
            <div class="form-group">
              <label class="form-label">
                <span class="label-icon">🖼️</span>
                Current Image
              </label>
              <div class="current-image">
                <img src="<%= @item.image_path %>" alt="<%= @item.title %>">
                <p class="image-note">Current image will be displayed</p>
              </div>
            </div>
          <% end %>

          <!-- New Image Upload -->
          <div class="form-group">
            <%= f.label :image, class: "form-label" do %>
              <span class="label-icon">📸</span>
              <%= @item.image_path.present? ? "Change Image (Optional)" : "Upload Image (Optional)" %>
            <% end %>
            <div class="file-upload-area" id="fileUploadArea">
              <%= f.file_field :image, class: "file-input", id: "item_image", accept: "image/*", style: "display: none;" %>
              <div class="upload-instructions" id="uploadInstructions" onclick="document.getElementById('item_image').click()">
                <span class="upload-icon">📸</span>
                <p>Click to browse or drag & drop an image</p>
                <small>Supports JPG, PNG, GIF (Max 5MB)</small>
              </div>
              <div class="upload-preview" id="uploadPreview" style="display: none;"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Description (Full Width) -->
      <div class="form-group full-width">
        <%= f.label :description, class: "form-label" do %>
          <span class="label-icon">📝</span>
          Description
        <% end %>
        <%= f.text_area :description, 
              class: "form-textarea", 
              rows: 6, 
              placeholder: "Describe the item in detail (color, brand, distinguishing features, location, etc.)",
              required: true %>
        <div class="form-hint">Provide as much detail as possible to help identify the item</div>
      </div>

      <!-- Form Actions -->
      <div class="form-actions">
        <%= f.submit "Update Item", class: "btn btn-primary" %>
        <%= link_to "Cancel", dashboard_index_path, class: "btn btn-secondary" %>
        <%= link_to "View Item", @item, class: "btn btn-outline" %>
      </div>
    <% end %>

    <!-- Danger Zone -->
    <div class="danger-zone">
      <div class="danger-header">
        <span class="danger-icon">⚠️</span>
        <h3>Danger Zone</h3>
      </div>
      <div class="danger-content">
        <div class="danger-info">
          <strong>Delete this item</strong>
          <p>Once deleted, this item cannot be recovered. All comments and claims will also be removed.</p>
        </div>
        <%= button_to "Delete Item", 
              @item, 
              method: :delete, 
              data: { confirm: "Are you absolutely sure you want to delete this item? This action cannot be undone." },
              class: "btn btn-danger" %>
      </div>
    </div>
  </div>
</div>

<style>
  /* Edit Item Styles */
  .edit-item-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 24px;
  }

  /* Back Button */
  .back-button {
    margin-bottom: 24px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #3b82f6;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .back-link:hover {
    transform: translateX(-4px);
    color: #2563eb;
  }

  /* Edit Item Card */
  .edit-item-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 25px -12px rgba(0, 0, 0, 0.1);
    border: 1px solid #e2e8f0;
  }

  /* Card Header */
  .card-header {
    background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
    padding: 32px;
    display: flex;
    align-items: center;
    gap: 16px;
    color: white;
    position: relative;
  }

  .header-icon {
    font-size: 48px;
  }

  .header-text h1 {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .header-text p {
    font-size: 14px;
    opacity: 0.9;
    margin: 0;
  }

  .item-status-badge {
    margin-left: auto;
    padding: 8px 20px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
  }

  .item-status-badge.lost {
    background: rgba(239, 68, 68, 0.8);
  }

  .item-status-badge.found {
    background: rgba(16, 185, 129, 0.8);
  }

  /* Form Styles */
  .edit-item-form {
    padding: 32px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-bottom: 24px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
  }

  .form-group.full-width {
    grid-column: span 2;
  }

  .form-label {
    font-size: 14px;
    font-weight: 600;
    color: #1e293b;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .label-icon {
    font-size: 16px;
  }

  .form-input,
  .form-select,
  .form-textarea {
    padding: 12px 14px;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    font-size: 14px;
    transition: all 0.3s ease;
    font-family: inherit;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }

  .form-textarea {
    resize: vertical;
  }

  .form-hint {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #64748b;
    margin-top: 4px;
  }

  .status-select-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .status-hint {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #64748b;
  }

  /* Checkbox Group */
  .checkbox-group {
    flex-direction: row;
    align-items: flex-start;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
  }

  .checkbox-input {
    width: 20px;
    height: 20px;
    margin-top: 2px;
    cursor: pointer;
  }

  .checkbox-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .checkbox-text strong {
    font-size: 14px;
    color: #1e293b;
  }

  .checkbox-text small {
    font-size: 12px;
    color: #64748b;
    font-weight: normal;
  }

  /* Current Image */
  .current-image {
    background: #f8fafc;
    border-radius: 12px;
    padding: 16px;
    text-align: center;
    border: 1px solid #e2e8f0;
  }

  .current-image img {
    max-width: 100%;
    max-height: 150px;
    border-radius: 8px;
  }

  .image-note {
    font-size: 12px;
    color: #64748b;
    margin-top: 8px;
  }

  /* File Upload */
  .file-upload-area {
    border: 2px dashed #e2e8f0;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
    background: #f8fafc;
  }

  .file-upload-area:hover {
    border-color: #3b82f6;
    background: #f0f9ff;
  }

  .upload-instructions {
    padding: 32px;
    text-align: center;
  }

  .upload-icon {
    font-size: 48px;
  }

  .upload-instructions p {
    margin: 12px 0 4px;
    color: #1e293b;
    font-weight: 500;
  }

  .upload-instructions small {
    color: #64748b;
    font-size: 12px;
  }

  .upload-preview {
    display: none;
    padding: 20px;
    text-align: center;
  }

  .upload-preview img {
    max-width: 100%;
    max-height: 200px;
    border-radius: 8px;
    margin-bottom: 12px;
  }

  /* Form Actions */
  .form-actions {
    display: flex;
    gap: 16px;
    padding-top: 24px;
    margin-top: 24px;
    border-top: 1px solid #e2e8f0;
    flex-wrap: wrap;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    border-radius: 12px;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
    color: white;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(59, 130, 246, 0.3);
  }

  .btn-secondary {
    background: #64748b;
    color: white;
  }

  .btn-secondary:hover {
    background: #475569;
    transform: translateY(-2px);
  }

  .btn-outline {
    background: transparent;
    color: #3b82f6;
    border: 2px solid #3b82f6;
  }

  .btn-outline:hover {
    background: #3b82f6;
    color: white;
    transform: translateY(-2px);
  }

  .btn-danger {
    background: #ef4444;
    color: white;
  }

  .btn-danger:hover {
    background: #dc2626;
    transform: translateY(-2px);
  }

  /* Danger Zone */
  .danger-zone {
    margin: 0 32px 32px 32px;
    padding: 24px;
    background: #fef2f2;
    border-radius: 16px;
    border: 2px solid #fee2e2;
  }

  .danger-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .danger-icon {
    font-size: 24px;
  }

  .danger-header h3 {
    font-size: 18px;
    font-weight: 700;
    color: #dc2626;
    margin: 0;
  }

  .danger-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .danger-info strong {
    display: block;
    color: #991b1b;
    margin-bottom: 4px;
  }

  .danger-info p {
    color: #7f1d1d;
    font-size: 13px;
    margin: 0;
  }

  /* Animations */
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .edit-item-card {
    animation: slideIn 0.4s ease-out;
  }

  /* Status hint dynamic text */
  .form-select {
    cursor: pointer;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .edit-item-container {
      padding: 16px;
    }

    .card-header {
      flex-direction: column;
      text-align: center;
      padding: 24px;
    }

    .header-icon {
      font-size: 36px;
    }

    .header-text h1 {
      font-size: 24px;
    }

    .item-status-badge {
      margin-left: 0;
    }

    .form-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .form-group.full-width {
      grid-column: span 1;
    }

    .edit-item-form {
      padding: 24px;
    }

    .form-actions {
      flex-direction: column;
    }

    .form-actions .btn {
      width: 100%;
    }

    .danger-zone {
      margin: 0 24px 24px 24px;
    }

    .danger-content {
      flex-direction: column;
      text-align: center;
    }
  }
</style>

<!-- JavaScript for Image Preview and Status Hint -->
<script>
  // Image preview functionality
  const fileInput = document.getElementById('item_image');
  const uploadInstructions = document.getElementById('uploadInstructions');
  const uploadPreview = document.getElementById('uploadPreview');
  
  if (fileInput) {
    fileInput.addEventListener('change', function(event) {
      const file = event.target.files[0];
      if (file && file.type.startsWith('image/')) {
        const reader = new FileReader();
        
        reader.onload = function(e) {
          uploadInstructions.style.display = 'none';
          uploadPreview.style.display = 'block';
          uploadPreview.innerHTML = `
            <img src="${e.target.result}" alt="Preview">
            <div class="preview-info">
              <span>${file.name}</span>
              <button type="button" class="remove-image" onclick="removeImage()">Remove</button>
            </div>
          `;
        };
        
        reader.readAsDataURL(file);
      } else if (file) {
        alert('Please select a valid image file (JPG, PNG, or GIF)');
        fileInput.value = '';
      }
    });
  }
  
  function removeImage() {
    fileInput.value = '';
    uploadInstructions.style.display = 'block';
    uploadPreview.style.display = 'none';
    uploadPreview.innerHTML = '';
  }
  
  // Status hint update
  const statusSelect = document.querySelector('.form-select');
  const statusHint = document.getElementById('statusHint');
  
  if (statusSelect && statusHint) {
    statusSelect.addEventListener('change', function() {
      if (this.value === 'lost') {
        statusHint.innerHTML = '📌 Lost items will appear in the "Lost" section and be visible to everyone';
      } else if (this.value === 'found') {
        statusHint.innerHTML = '📌 Found items will appear in the "Found" section and be visible to everyone';
      }
    });
  }
</script>

<style>
  /* Additional styles for preview */
  .preview-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
    padding: 8px 12px;
    background: #f1f5f9;
    border-radius: 8px;
    font-size: 12px;
  }
  
  .remove-image {
    background: #ef4444;
    color: white;
    border: none;
    padding: 4px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 12px;
    font-weight: 500;
    transition: all 0.3s ease;
  }
  
  .remove-image:hover {
    background: #dc2626;
  }
</style>